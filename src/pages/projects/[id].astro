---
// Dynamic project detail pages
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';

// Define all your projects here - MUST be defined inside getStaticPaths for export
export async function getStaticPaths() {
  const allProjects: Record<string, any> = {
    "gimbaled-reaction-cube": {
      "images": [{"src": "/media/cube-simulation-example.jpg", "alt": "Simulation plots of cube and gimbal angles, rotational speeds and gimbal torque", "caption": "Saved simulation case: cube and gimbal motion, rotational speeds and torque. Model output, not a hardware test or a final specification."}, {"src": "/media/cube-flywheel-simulation.jpg", "alt": "Saved flywheel simulation plots with geometry and motor parameters", "caption": "A second saved simulation case with flywheel and motor parameters. The two figures represent different model configurations."}],
      "title": "Gimbaled Reaction Wheel Cube",
      "description": "Investigating and developing an underactuated cube robot that uses a single gimbaled reaction wheel for controlled tipping and balance. The project explores the mechanism’s nonlinear dynamics and control, using mathematical modelling, simulation and design optimisation to assess its feasibility and guide prototype development.",
      "longDescription": "This final-year research project investigates the development and control of an underactuated cube robot driven by a single gimbaled reaction wheel. The central question is how this mechanism can exploit coupled rotational dynamics to achieve controlled tipping and balance with fewer independent actuators than controlled degrees of freedom.\n\nThe proposed mechanism combines flywheel rotation with changes in the orientation of its spin axis. Flywheel acceleration produces a reaction torque, while gimbal motion redirects angular momentum and generates gyroscopic torque. The research examines how these effects can be coordinated to produce the desired cube motion, investigating a single gimbaled assembly as an alternative to three orthogonal reaction wheels.\n\nA central part of the investigation is the control of this nonlinear, underactuated system. The project explores the relationship between mechanical configuration, available control torque and achievable motion, with the aim of developing control strategies for tipping manoeuvres and balance. Mechanical design and control are considered together, since actuator capabilities and flywheel geometry constrain the system’s behaviour.",
      "sections": [{"title": "Proposed Research Plan", "paragraphs": ["The research will progress from planar modelling and simulation towards physical validation, before extending the investigation to three-dimensional motion. Control development will accompany each stage so that the mechanism and its control strategy are evaluated together. The following stages describe the proposed research sequence."], "steps": ["Derive the planar equations of motion. Establish the mathematical relationships between cube motion, flywheel rotation and gimbal actuation, identifying the assumptions and constraints of the model.", "Develop the planar simulation. Implement and verify the equations numerically, investigating the coupled dynamics and predicted tipping behaviour.", "Optimise the initial configuration. Investigate flywheel geometry and actuator requirements within practical mass, speed and power constraints.", "Investigate planar dynamics and control. Develop strategies for tipping and balance and examine the transition between them. Evaluate sensitivity to initial conditions, parameter uncertainty and actuator limits.", "Implement and validate a physical prototype. Build the selected configuration, implement the control strategies and compare measured behaviour with model predictions. Use discrepancies to refine the model and design.", "Extend the investigation to three dimensions. Derive the spatial equations of motion, then repeat simulation, optimisation and control development while accounting for coupled motion across multiple axes and the available control authority.", "Evaluate spatial control experimentally. Adapt the prototype and control implementation for three-dimensional operation and assess achievable tipping and balancing behaviours against model predictions."]}, {"title": "Derivation of the Equations of Motion", "paragraphs": ["The mathematical formulation investigates the coupled motion of the cube, flywheel and gimbal. The equations of motion describe how gravitational effects, flywheel acceleration and changes in the flywheel’s orientation contribute to the system’s rotational dynamics.", "The initial formulation considers planar cube motion as a basis for investigating tipping and balance. It establishes the relationship between actuator inputs and system response, providing the foundation for numerical simulation, design optimisation and control development. The modelling assumptions and constraints will also inform the subsequent extension to three-dimensional motion."], "document": {"href": "/documents/cube_2d_mathematical_model.pdf", "label": "Read the 2D mathematical model (PDF)"}}, {"title": "Simulation Implementation", "paragraphs": ["A nonlinear mathematical model was implemented in Python to investigate the relationship between flywheel rotation, gimbal motion and cube dynamics. The simulation provides an environment for evaluating candidate configurations and examining how mechanical parameters influence the predicted tipping behaviour.", "The computational workflow supports repeated evaluation across a range of flywheel geometries and operating conditions. Each simulated case provides performance measures for comparing designs and estimating the mechanical and actuator requirements of the proposed system."]}, {"title": "Design Optimisation", "paragraphs": ["A numerical study evaluated 19,088 simulated cases across 157 flywheel geometries. Successful configurations were compared using a weighted ranking procedure that considers component mass, tipping time and target rotational speed. Min–max normalisation allows these quantities to contribute to a common design score.", "The search refines candidate parameters around the best tested configuration. The selected flywheel geometry then informs a subsequent investigation of gimbal actuator requirements under a power constraint. This approach connects the simulated dynamics with hardware specification, while recognising that the preferred design depends on the model assumptions, optimisation weights and explored design space.", "The current outcome is a simulation and optimisation workflow that supports investigation of the mechanism and definition of its technical specification. Further work will develop and evaluate its control strategies and progress towards experimental validation of controlled tipping and balance."]}],
      "technologies": [
        "Python",
        "Nonlinear dynamics",
        "Numerical simulation",
        "Design optimisation"
      ],
      "github": "https://github.com/tarasfl/Gimbaled-Reaction-Cube",
      "date": "Current final-year project"
    },
    "gnss-denied-drone": {
      "images": [{"src": "/media/drone-hardware.jpg", "alt": "Drone prototype on a workbench with onboard electronics, battery and landing gear", "caption": "Drone prototype during hardware integration."}, {"src": "/media/drone-concept.jpg", "alt": "Conceptual exploded illustration of a drone with flight electronics, onboard computer and stereo cameras", "caption": "Conceptual exploded illustration. Internal components are shown schematically; this is not an assembly photograph or engineering drawing."}, {"src": "/media/drone-dashboard.jpg", "alt": "Drone control dashboard showing stereo views, feature tracks and estimated motion plots", "caption": "Navigation dashboard with stereo imagery, feature tracking and estimated motion. This screenshot alone does not establish the drift metric."}, {"type": "video", "src": "/media/drone-outdoor-test.mp4", "poster": "/media/drone-outdoor-test-poster.jpg", "alt": "Outdoor drone test excerpt", "caption": "20-second silent excerpt from an outdoor drone test, showing the aircraft taking off and moving above the court. The footage does not establish the navigation mode."}, {"type": "video", "src": "/media/drone-navigation-screen.mp4", "poster": "/media/drone-navigation-screen-poster.jpg", "alt": "Screen recording of the navigation dashboard", "caption": "30-second silent excerpt of the navigation dashboard: stereo feature tracking and estimated trajectories update during the recording."}],
      "title": "Drone Navigation without GNSS",
      "description": "Investigating vision-based drone navigation without GNSS using downward-facing stereo cameras and inertial measurements. Developed through a group project at the EUDIS Defence Hackathon Ireland, the work combines feature tracking, depth estimation and sensor fusion, with ongoing research into multiscale feature selection for reliable motion estimation in vegetation-rich environments.",
      "longDescription": "This project investigates local motion estimation for a drone operating without Global Navigation Satellite System (GNSS) signals. The approach combines downward-facing stereo imagery with inertial measurements to estimate motion relative to the observed environment. The central research objective is to improve the reliability of visual navigation while maintaining a bounded computational cost suitable for onboard processing.\n\nThe project originated through collaborative work at the EUDIS Defence Hackathon Ireland, where our team reached the finals. My contribution included co-development of the navigation algorithm, simulation-based investigation and support for physical drone integration. The subsequent research develops the mathematical methodology and identifies extensions to the existing estimation pipeline.",
      "sections": [{"title": "Stereo Geometry and Motion Estimation", "paragraphs": ["The existing implementation combines corner detection, pyramidal Lucas–Kanade tracking and sparse stereo correspondence. Temporal observations describe the apparent motion of image features, while stereo disparity provides metric depth information. Gyroscope measurements support compensation for camera rotation, allowing translational motion to be estimated from the remaining image flow.", "The current pipeline includes a planar velocity fit and a simplified Kalman fusion model. Further development focuses on consistent calibration, coordinate transformations and measurement timing, together with depth-aware estimation that accounts for surfaces at different distances from the camera."]}, {"title": "Multiscale Feature Selection", "paragraphs": ["A principal research question is whether distributing a fixed feature budget across image scales and spatial regions can improve depth reliability and velocity estimation in vegetation-rich scenes. Fine-scale detectors can select many features from grass while retaining fewer observations of larger structural boundaries.", "The proposed extension preserves useful fine-scale tracks while introducing coarser-scale corners and line-guided candidate regions. Spatial allocation and duplicate suppression are intended to improve observation coverage without increasing the total tracking budget. These extensions remain proposed work and require comparison with a corrected single-scale baseline."]}, {"title": "Evaluation and Further Development", "paragraphs": ["The evaluation methodology separates feature coverage from navigation accuracy. Proposed experiments compare depth error, velocity error, trajectory drift, observation availability and processing latency using identical stereo and inertial sequences with known ground truth. Controlled variations in scene texture, motion, illumination, calibration and timing are intended to identify the conditions under which each approach remains reliable.", "The current outcome is an initial navigation implementation and a structured methodology for its further investigation. Subsequent work will evaluate the proposed multiscale extensions, refine uncertainty handling and assess sustained performance on the onboard platform. Integration with closed-loop flight control follows validation of the motion estimates."]}],
      "technologies": [
        "Stereo vision",
        "Optical flow",
        "Least squares",
        "Kalman filtering"
      ],
      "github": "https://github.com/colaider/droneResearch",
      "date": "October 2026"
    },
    "mars-rover-manipulator": {
      "images": [{"src": "/media/rover-arm-cad.jpg", "alt": "Fusion 360 CAD view of a rover-arm joint bracket and tubular link", "caption": "Rover-arm component CAD: joint bracket and tubular link."}, {"src": "/media/rover-arm-displacement.jpg", "alt": "Fusion 360 total displacement plot for the arm component, with a maximum displayed displacement of 0.694 millimetres", "caption": "Total displacement result from a static structural study. The displayed maximum is 0.694 mm for the shown load case; this is not a stress or factor-of-safety plot."}],
      "title": "Mars Rover Manipulator",
      "description": "Mechanical design and control investigation for a lightweight six-axis manipulator as part of university research at SETU supporting the European Rover Challenge. My contribution combined component modelling, structural simulation and Python-based control development to investigate the arm’s mechanical behaviour and support its integration into the rover system.",
      "longDescription": "This university research project at SETU investigated the design and development of a lightweight six-axis robotic manipulator for the European Rover Challenge rover. The work examined the relationship between component geometry, structural rigidity and mass, alongside control development and mechanical integration.\n\nThe research was undertaken within a university team under the supervision of Andrew Keppel. My contribution focused on mechanical component design, simulation-based structural assessment, investigation of control logic and support for assembly.",
      "sections": [{"title": "Mechanical Design", "paragraphs": ["Components were developed using SolidWorks and Autodesk Fusion 360 to investigate suitable configurations for the arm’s joints and links. The design work considered mechanical interfaces and the contribution of individual components to the overall structure, with particular attention to balancing low mass and structural rigidity."]}, {"title": "Structural Investigation", "paragraphs": ["Static structural simulation was used to examine component behaviour under applied loading. Stress and displacement results informed the assessment of material use and structural performance, with a reported factor of safety of five.", "The accompanying displacement plot presents the predicted deformation of an arm component under the displayed load case. The results provide evidence within the assumptions of the numerical model; experimental testing would be required to assess their correspondence with physical behaviour."]}, {"title": "Control Development and Integration", "paragraphs": ["Python-based control logic was developed and investigated through simulation alongside the mechanical design. Participation in assembly supported the integration of the designed components within the wider manipulator and connected the modelling work with practical implementation.", "The project provided a setting for investigating mechanical design and control within a collaborative university robotics programme. My contribution comprised component designs, structural analyses and control-development work supporting the continued development of the rover manipulator."]}],
      "technologies": [
        "SolidWorks",
        "Fusion 360",
        "Stress simulation",
        "Python",
        "Mechanical assembly"
      ],
      "date": "September 2024 – October 2025"
    },
    "smartbreadboard": {
      "images": [{"src": "/media/smartbreadboard-pcb-render.jpg", "alt": "Three-dimensional render of the green Smartbreadboard PCB with three integrated circuits and connection headers", "caption": "KiCad 3D view of the Smartbreadboard PCB design."}, {"src": "/media/smartbreadboard-pcb-layout.jpg", "alt": "Smartbreadboard PCB layout showing component footprints, red and blue routed tracks and mounting holes", "caption": "PCB routing layout, showing the connections between the switching matrices, interface circuitry and headers."}, {"src": "/media/smartbreadboard-assembled-pcb.jpg", "alt": "Assembled green Smartbreadboard PCB with soldered integrated circuits and pin headers", "caption": "Assembled Smartbreadboard PCB with fitted components and headers."}, {"src": "/media/smartbreadboard-prototype.jpg", "alt": "Smartbreadboard development setup with interconnected breadboards, an Arduino board and jumper wires", "caption": "Breadboard development setup with controller, interface circuitry and jumper-wire connections."}],
      "title": "Smartbreadboard Programmable PCB",
      "description": "Investigating software-configurable circuit prototyping as an alternative to repeated manual rewiring. Smartbreadboard proposes a programmable switching platform combining a custom PCB, analogue crosspoint switches and Arduino-compatible control. The project explores hardware implementation, connection routing and the electrical constraints of reconfigurable circuits.",
      "longDescription": "Smartbreadboard investigates whether electronically controlled connections can provide a practical alternative to manual rewiring during circuit prototyping. Conventional breadboards support rapid experimentation, but changing a circuit requires physical modification of its connections. This project proposes a software-configurable platform in which a switching network establishes electrical paths between accessible circuit nodes.\n\nThe investigation combines electronic hardware design, embedded software and connection-routing logic. Its central question is how programmable analogue switches can support circuit reconfiguration while accommodating the routing and electrical constraints imposed by the hardware.",
      "sections": [{"title": "Proposed Architecture", "paragraphs": ["The proposed platform uses MT8816 analogue crosspoint switches, an MCP23017 I/O expander and an Arduino-compatible controller. Software commands select individual crosspoints to establish connections through the switching network. A custom PCB integrates the switching devices, control interface, power distribution and external connection headers.", "The architecture separates low-level switch control from the higher-level task of interpreting requested circuit connections. This allows the hardware interface and routing software to be developed and evaluated independently before integration."]}, {"title": "Hardware Design and Implementation", "paragraphs": ["The hardware work included schematic capture, component and footprint selection, PCB routing and preparation of manufacturing and assembly files. The design process examined how component availability, interface requirements and manufacturability constrain the implementation of the proposed platform.", "The accompanying development images document the progression from a breadboard setup to the routed PCB design and assembled board. These stages provide a physical basis for investigating the switching architecture and its control interface."]}, {"title": "Embedded Control and Connection Routing", "paragraphs": ["An Arduino library provides low-level control of the MT8816 switching hardware. Higher-level firmware and automatic routing remain under development.", "The proposed routing layer would translate requests to connect circuit nodes into a feasible configuration of available switches. This requires consideration of shared resources, conflicting connections, simultaneous circuit nets and requests that cannot be realised by the switching topology. The objective is to progress from specifying individual crosspoints to describing the intended circuit connections."]}, {"title": "Evaluation and Further Development", "paragraphs": ["The proposed evaluation addresses both connection correctness and electrical behaviour. Planned tests include continuity, individual and simultaneous switch operation, active-path resistance, analogue and digital signal transmission, and switching reliability.", "The current work establishes the hardware design and a low-level software interface for further investigation. Subsequent development will integrate these elements, characterise their practical limitations and evaluate software-controlled reconfiguration using demonstration circuits."]}],
      "technologies": [
        "KiCad",
        "Arduino",
        "I2C",
        "MT8816",
        "Logic analyser"
      ],
      "github": "https://github.com/tarasfl/SmartBreadboard-",
      "date": "January – August 2026"
    },
    "ball-levitation": {
      "images": [{"src": "/media/ball-levitation-demo-poster.jpg", "alt": "Still from the ball-levitation demonstration showing a yellow ball in the vertical apparatus", "caption": "Still from the levitation demonstration, with the ball visible in the vertical apparatus."}, {"type": "video", "src": "/media/ball-levitation-demo.mp4", "poster": "/media/ball-levitation-demo-poster.jpg", "alt": "Ball-levitation apparatus and control software demonstration", "caption": "Short silent demonstration of the levitation apparatus and control software. The supplied circular framing is preserved."}, {"src": "/media/ball-assembly-cad.png", "alt": "CAD assembly of the vertical ball-levitation tube, fan base and upper sensor mount", "caption": "CAD assembly of the ball-levitation apparatus, from our team project report. The source figure is available only at this resolution."}, {"src": "/media/ball-mechanical-iterations.png", "alt": "CAD design iterations of the fan nozzle, airflow mesh and supporting base", "caption": "Mechanical design iterations from our team report: nozzle and airflow components above, supporting base below."}, {"src": "/media/ball-system-connections.png", "alt": "System connection diagram linking a Siemens PLC, Arduino, heartbeat relay, fan and two ultrasonic sensors", "caption": "Team report connection diagram: Arduino–PLC communication over Modbus TCP, fan PWM control and the heartbeat relay."}, {"src": "/media/ball-hmi-screen.png", "alt": "HMI design screen with ball height, high and low setpoints, stop button and heartbeat indicator", "caption": "HMI main-screen design from the team report, showing the height display, setpoint controls and heartbeat indicator."}],
      "title": "Ball Levitation System",
      "description": "Design and implementation of a feedback-controlled ball levitation system as a university group project. The system combines ultrasonic sensing, Arduino–PLC communication and PID control to regulate ball height through fan-driven airflow. My contribution focused on sensing, communication, control tuning and the design of 3D-printed mechanical components.",
      "longDescription": "This university group project involved designing, building and testing a system that controls the height of a ball suspended by airflow in a vertical tube. The objective was to integrate sensing, industrial control and mechanical design into a working closed-loop system.\n\nThe project was completed by a three-member team. My contribution focused on Arduino-based sensing and communication, PID tuning, measurement filtering and the design of mechanical components supporting airflow and sensor placement.",
      "sections": [{"title": "System Design", "paragraphs": ["A fan generates the airflow required to lift the ball, while an ultrasonic sensor measures its position. A Siemens S7-1500 PLC calculates the control response, and an Arduino acquires sensor measurements and generates the fan’s PWM control signal. Data is exchanged between the Arduino and PLC using Modbus TCP.", "An HMI provides controls and displays system information, including ball height, setpoints and communication status. A heartbeat signal allows the PLC to detect interruption of Arduino operation and respond through the system’s fault-handling logic."]}, {"title": "Sensing and Feedback Control", "paragraphs": ["Ultrasonic measurements are filtered before transmission to reduce noise in the feedback signal. The PLC uses PID control to adjust the fan command according to the difference between the measured ball height and the target position.", "Control tuning was carried out alongside testing of the sensing and communication functions. This process examined how measurement noise, airflow behaviour and actuator response affected the stability of the levitated ball."]}, {"title": "Mechanical Development", "paragraphs": ["The mechanical design was refined through several iterations of the base, fan nozzle and sensor mounts. These components were designed in Autodesk Fusion 360 and produced using 3D printing.", "Testing showed that airflow geometry was important to successful levitation. The design therefore incorporated a nozzle and mesh element to guide the airflow, together with supports that maintained the alignment of the tube and ultrasonic sensors."]}, {"title": "Integration and Testing", "paragraphs": ["The assembled system was tested to assess sensor readings, Modbus communication, heartbeat monitoring and closed-loop height control. Mechanical testing informed changes to the airflow components, while control tests supported adjustment of the PID response.", "The project demonstrated the integration of embedded sensing, PLC-based control and an iteratively developed mechanical assembly. Further development could investigate more varied reference trajectories, improve the response speed and transfer fan actuation directly to a suitable PLC output module."]}],
      "technologies": [
        "Arduino",
        "Siemens PLC",
        "PID",
        "Modbus TCP",
        "3D printing"
      ],
      "date": "September – December 2025"
    }
  };
  
  const projects = Object.keys(allProjects);
  return projects.map((id) => ({
    params: { id },
    props: { project: allProjects[id] },
  }));
}

interface Props {
  project: {
    title: string;
    description: string;
    longDescription: string;
    sections?: { title: string; paragraphs: string[]; steps?: string[]; document?: { href: string; label: string } }[];
    technologies: string[];
    link?: string;
    github?: string;
    date?: string;
    images?: { src: string; alt: string; caption?: string; type?: "image" | "video"; poster?: string }[];
  };
}

const { project } = Astro.props as Props;
---

<Layout title={project.title}>
  <Header />

  <article class="project-detail">
    <a href="/" class="back-link">← Back to Home</a>

    <h1>{project.title}</h1>
    <p class="meta">
      {project.date && <span class="date">{project.date}</span>}
    </p>

    {project.images && <ProjectGallery title={project.title} images={project.images} />}

    <div class="content">
      {project.longDescription.split('\n\n').map((para) => (
        <p>{para.trim()}</p>
      ))}
      {project.sections?.map(section => (
        <section class="research-subsection">
          <h3>{section.title}</h3>
          {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          {section.document && <p><a href={section.document.href} target="_blank" rel="noopener noreferrer">{section.document.label}</a></p>}
          {section.steps && <ol>{section.steps.map(step => <li>{step}</li>)}</ol>}
        </section>
      ))}
    </div>

    <div class="project-links">
      {project.link && (
        <a href={project.link} target="_blank" rel="noopener noreferrer">
          View Project
        </a>
      )}
      {project.github && (
        <a href={project.github} target="_blank" rel="noopener noreferrer">
          View on GitHub
        </a>
      )}
    </div>
  </article>

  <Footer />
</Layout>

<style>
  .project-detail {
    max-width: 900px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: #000;
    text-decoration: underline;
  }

  .back-link:hover {
    color: #333;
  }

  h1 {
    font-size: 2rem;
    font-weight: normal;
    margin-bottom: 0.5rem;
  }

  .meta {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  .date {
    display: inline-block;
    font-style: italic;
  }

  .content {
    margin: 2rem 0;
    line-height: 1.6;
  }

  .content p {
    margin-bottom: 1rem;
    text-align: justify;
  }

  .technologies {
    margin: 2rem 0;
  }

  .technologies h3 {
    margin-top: 0;
  }

  .technologies ul {
    list-style: none;
    padding-left: 0;
  }

  .technologies li {
    padding-left: 1.5rem;
    position: relative;
  }

  .technologies li::before {
    content: '•';
    position: absolute;
    left: 0;
  }

  .project-links {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
  }

  .project-links a {
    color: #000;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.5rem;
    }

    .project-links {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

<style>.research-subsection{margin-top:2.5rem}.research-subsection h3{margin-bottom:1rem}.research-subsection li{margin-bottom:1rem;padding-left:.3rem}.research-subsection ol{margin-top:1rem}</style>
