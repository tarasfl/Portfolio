---
// Main index page - plain academic style
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Research from '../components/Research.astro';
import TechnicalNotes from '../components/TechnicalNotes.astro';
import Experience from '../components/Experience.astro';
import CV from '../components/CV.astro';
import Footer from '../components/Footer.astro';

// Your information - edit this section
const portfolioData = {
  name: 'Your Name',
  title: 'Research Title',
  university: 'Your University',
  academicFocus: 'Your Research Focus',
  researchStatement: 'Brief statement about your research interests and what drives your work.',
  cvLink: '#cv',
  githubLink: 'https://github.com/yourusername',
  linkedinLink: 'https://linkedin.com/in/yourusername',
};

const projects = [
  {
    title: 'Project Title',
    description: 'Brief description of your project including the problem and your contributions.',
    link: '#',
    github: 'https://github.com/yourusername/project',
  },
];

const notes = [
  {
    title: 'Article Title',
    excerpt: 'Brief excerpt about what this article covers.',
    date: 'Date',
    link: '#',
  },
];

const experiences = [
  {
    title: 'Position Title',
    organization: 'Company Name',
    period: 'Month Year - Month Year',
    description: 'Brief description of your role.',
  },
];

const education = [
  {
    degree: 'Degree Name',
    field: 'Field of Study',
    school: 'University Name',
    year: 'Year',
  },
];

const skills = [
  {
    category: 'Programming',
    items: ['Python', 'JavaScript', 'C++'],
  },
];
---

<Layout title="Academic Portfolio">
  <Header />
  <Hero name={portfolioData.name} title={portfolioData.title} />
  <About
    university={portfolioData.university}
    academicFocus={portfolioData.academicFocus}
    researchStatement={portfolioData.researchStatement}
    cvLink={portfolioData.cvLink}
    githubLink={portfolioData.githubLink}
    linkedinLink={portfolioData.linkedinLink}
  />
  <Research projects={projects} />
  <TechnicalNotes notes={notes} />
  <Experience experiences={experiences} />
  <CV education={education} skills={skills} />
  <Footer />
</Layout>
