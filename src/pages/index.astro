---
// Main index page - plain academic style
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import TechnicalNotes from '../components/TechnicalNotes.astro';
import Experience from '../components/Experience.astro';
import CV from '../components/CV.astro';
import Footer from '../components/Footer.astro';

// Your information - edit this section
const portfolioData = {
  name: 'Your Name',
  title: 'Research Title',
  description: 'Brief description of yourself, your background, and research interests. Add a professional photo in the photo field below.',
  photo: '', // Add path to your photo here, e.g., '/profile.jpg'
};

const projects = [
  {
    id: 'project-1',
    title: 'Project Title',
    description: 'Brief description of your project.',
    github: 'https://github.com/yourusername/project',
  },
];

const notes = [
  {
    title: 'Article Title',
    excerpt: 'Brief excerpt about what this article covers.',
    date: 'Date',
    link: '#',
  },
];

const experiences = [
  {
    title: 'Position Title',
    organization: 'Company Name',
    period: 'Month Year - Month Year',
    description: 'Brief description of your role.',
  },
];

const education = [
  {
    degree: 'Degree Name',
    field: 'Field of Study',
    school: 'University Name',
    year: 'Year',
  },
];

const skills = [
  {
    category: 'Programming',
    items: ['Python', 'JavaScript', 'C++'],
  },
];
---

<Layout title="Academic Portfolio">
  <Header />
  
  <Hero
    name={portfolioData.name}
    title={portfolioData.title}
    description={portfolioData.description}
    photo={portfolioData.photo}
  />

  <Projects projects={projects} />

  <TechnicalNotes notes={notes} />

  <Experience experiences={experiences} />

  <CV
    education={education}
    skills={skills}
    cvLink="#cv"
    githubLink="https://github.com/yourusername"
    linkedinLink="https://linkedin.com/in/yourusername"
  />

  <Footer />
</Layout>
