---
// Main index page - plain academic style
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import TechnicalNotes from '../components/TechnicalNotes.astro';
import Experience from '../components/Experience.astro';
import CV from '../components/CV.astro';
import Footer from '../components/Footer.astro';

// Your information - edit this section
const portfolioData = {
  "name": "Taras Fliorko",
  "title": "Final-year Robotics Student | Dynamics, Control and Underactuated Systems",
  "description": "I’m a final-year Robotics and Automated Systems student at South East Technological University in Carlow, Ireland. My work brings together mathematical modelling, nonlinear simulation, mechanical design and embedded control. I’m interested in how physical models inform the design and control of robotic systems, particularly underactuated systems. My current final-year project investigates controlled tipping and balance using a single gimbaled reaction wheel. I’m preparing for Master’s study in robotics and control, building on projects in rover manipulation, vision-based navigation and programmable electronics.",
  "photo": "/media/taras-portrait.jpg"
};

const projects = [
  {
    "id": "gimbaled-reaction-cube",
    "image": "/media/cube-simulation-example.jpg",
    "title": "Gimbaled Reaction Wheel Cube",
    "description": "Investigating and developing an underactuated cube robot that uses a single gimbaled reaction wheel for controlled tipping and balance. The project explores the mechanism’s nonlinear dynamics and control, using mathematical modelling, simulation and design optimisation to assess its feasibility and guide prototype development.",
    "github": "https://github.com/tarasfl/Gimbaled-Reaction-Cube"
  },
  {
    "id": "gnss-denied-drone",
    "image": "/media/drone-hardware.jpg",
    "title": "Drone Navigation without GNSS",
    "description": "Investigating vision-based drone navigation without GNSS using downward-facing stereo cameras and inertial measurements. Developed through a group project at the EUDIS Defence Hackathon Ireland, the work combines feature tracking, depth estimation and sensor fusion, with ongoing research into multiscale feature selection for reliable motion estimation in vegetation-rich environments.",
    "github": "https://github.com/colaider/droneResearch"
  },
  {
    "id": "mars-rover-manipulator",
    "image": "/media/rover-arm-cad.jpg",
    "title": "Mars Rover Manipulator",
    "description": "Mechanical design and control investigation for a lightweight six-axis manipulator as part of university research at SETU supporting the European Rover Challenge. My contribution combined component modelling, structural simulation and Python-based control development to investigate the arm’s mechanical behaviour and support its integration into the rover system."
  },
  {
    "id": "smartbreadboard",
    "image": "/media/smartbreadboard-pcb-render.jpg",
    "title": "Smartbreadboard Programmable PCB",
    "description": "Investigating software-configurable circuit prototyping as an alternative to repeated manual rewiring. Smartbreadboard proposes a programmable switching platform combining a custom PCB, analogue crosspoint switches and Arduino-compatible control. The project explores hardware implementation, connection routing and the electrical constraints of reconfigurable circuits.",
    "github": "https://github.com/tarasfl/SmartBreadboard-"
  },
  {
    "id": "ball-levitation",
    "image": "/media/ball-levitation-demo-poster.jpg",
    "title": "Ball Levitation System",
    "description": "Design and implementation of a feedback-controlled ball levitation system as a university group project. The system combines ultrasonic sensing, Arduino–PLC communication and PID control to regulate ball height through fan-driven airflow. My contribution focused on sensing, communication, control tuning and the design of 3D-printed mechanical components."
  }
];

const notes = [
  {
    "title": "Mathematical Modelling of a Gimbaled Reaction Wheel Cube",
    "excerpt": "Derivation of a reduced nonlinear model for the planar tipping motion of a cube actuated by a gimbaled flywheel. The notes develop the mass distribution, effective inertias and gyroscopic coupling through a Lagrangian formulation, then examine actuator control, ground contact and the assumptions that govern the model’s applicability.",
    "link": "/notes/cube-mathematical-model/"
  }
];

const experiences = [
  {
    "title": "Engineering Intern",
    "organization": "Carlow Toolmaking Services",
    "period": "January – May 2026",
    "description": "Produced and updated tool CAD in Solid Edge, maintaining drawing versions and manufacturing documentation for machining. Supported wire EDM setup and CNC milling within the workshop team, applying guidance from toolmaking and machining specialists."
  },
  {
    "title": "Software Development",
    "organization": "Insoftex",
    "period": "February – August 2024",
    "description": "Developed a solar monitoring website with a software team using Svelte and JavaScript to collect and visualise energy output and system performance. Retrieved location and address information from satellite feeds for the monitoring project."
  },
  {
    "title": "Chess Club Co-founder and Chairperson",
    "organization": "South East Technological University",
    "period": "September 2024 – present",
    "description": "Co-founded and chaired a chess club with 25+ active members, built a team, and organised weekly sessions, tournaments and university events."
  },
  {
    "title": "EUDIS Defence Hackathon Participant — Team Finalist",
    "organization": "EUDIS Defence Hackathon Ireland",
    "period": "October 2026",
    "description": "Co-developed stereo-vision navigation for a drone operating without GNSS. Contributed to algorithm simulation, evaluation on real data and physical drone integration as part of a finalist team."
  }
];

const education = [
  {
    "degree": "BEng (Hons)",
    "field": "Robotics and Automated Systems",
    "school": "South East Technological University, Carlow, Ireland",
    "year": "2023 – May 2027 (expected)"
  },
  {
    "degree": "Studies",
    "field": "Computer Science and Internet of Things",
    "school": "Lviv Polytechnic National University, Ukraine",
    "year": "September 2021 – May 2023"
  }
];

const skills = [
  {
    "category": "Programming & analysis",
    "items": [
      "Python",
      "C/C++",
      "MATLAB",
      "Simulink",
      "JavaScript/TypeScript"
    ]
  },
  {
    "category": "Control & embedded systems",
    "items": [
      "Siemens TIA Portal",
      "S7-1500 PLC",
      "PID",
      "Arduino",
      "Modbus TCP",
      "I2C"
    ]
  },
  {
    "category": "Design & electronics",
    "items": [
      "SolidWorks",
      "Fusion 360",
      "Solid Edge",
      "3D printing",
      "KiCad",
      "Proteus",
      "Logic analyser"
    ]
  }
];
---

<Layout title="Taras Fliorko | Academic Engineering Portfolio">
  <Header />
  
  <Hero
    name={portfolioData.name}
    title={portfolioData.title}
    description={portfolioData.description}
    photo={portfolioData.photo}
  />

  <Projects projects={projects} />

  <TechnicalNotes notes={notes} />

  <Experience experiences={experiences} />

  <CV
    education={education}
    skills={skills}
    cvLink="/Taras_Fliorko_Academic.pdf"
    githubLink="https://github.com/tarasfl"
    linkedinLink="https://www.linkedin.com/in/taras-fliorko/"
  />

  <Footer />
</Layout>

