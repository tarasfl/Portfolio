---
// Main layout wrapper for all pages
interface Props {
  title?: string;
  description?: string;
}

const { title = 'Portfolio', description = 'Academic Research Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: Georgia, 'Times New Roman', serif;
        background-color: #ffffff;
        color: #000000;
        line-height: 1.6;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }

      h1 {
        font-size: 2rem;
        font-weight: normal;
        margin: 1.5rem 0 0.5rem 0;
      }

      h2 {
        font-size: 1.3rem;
        font-weight: normal;
        margin: 1.5rem 0 0.75rem 0;
        border-top: 1px solid #000;
        padding-top: 1rem;
      }

      h3 {
        font-size: 1rem;
        font-weight: bold;
        margin: 1rem 0 0.25rem 0;
      }

      p {
        margin-bottom: 0.75rem;
        text-align: justify;
      }

      a {
        color: #000000;
        text-decoration: underline;
      }

      a:hover {
        color: #333333;
      }

      ul, ol {
        margin-left: 2rem;
        margin-bottom: 1rem;
      }

      li {
        margin-bottom: 0.3rem;
      }

      section {
        margin-bottom: 2rem;
      }

      .container {
        max-width: 900px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
