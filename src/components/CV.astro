---
// Simple CV section
interface Education {
  degree: string;
  field: string;
  school: string;
  year: string;
}

interface Skill {
  category: string;
  items: string[];
}

interface Props {
  education?: Education[];
  skills?: Skill[];
  publications?: string[];
}

const {
  education = [],
  skills = [],
  publications = [],
} = Astro.props;
---

<section class="cv" id="cv">
  <h2>CV</h2>

  {education.length > 0 && (
    <>
      <h3>Education</h3>
      <div class="edu-list">
        {education.map((edu) => (
          <div class="edu-item">
            <p>
              <strong>{edu.degree}</strong> in {edu.field}
            </p>
            <p>{edu.school}, {edu.year}</p>
          </div>
        ))}
      </div>
    </>
  )}

  {skills.length > 0 && (
    <>
      <h3>Skills</h3>
      <div class="skills-list">
        {skills.map((skill) => (
          <div class="skill-item">
            <p>
              <strong>{skill.category}:</strong> {skill.items.join(", ")}
            </p>
          </div>
        ))}
      </div>
    </>
  )}

  {publications.length > 0 && (
    <>
      <h3>Publications</h3>
      <ul class="pub-list">
        {publications.map((pub) => (
          <li>{pub}</li>
        ))}
      </ul>
    </>
  )}
</section>

<style>
  .cv {
    margin-bottom: 2rem;
  }

  h2 {
    border-top: 1px solid #000;
    padding-top: 1rem;
    margin-top: 2rem;
  }

  h3 {
    margin-top: 1.5rem;
  }

  .edu-list,
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu-item,
  .skill-item {
    margin-bottom: 0.5rem;
  }

  .edu-item p,
  .skill-item p {
    margin: 0.25rem 0;
  }

  .pub-list {
    margin-left: 2rem;
    margin-bottom: 1rem;
  }

  .pub-list li {
    margin-bottom: 0.3rem;
  }
</style>
