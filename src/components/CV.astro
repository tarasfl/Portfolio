---
// CV section component
interface Education {
  degree: string;
  field: string;
  school: string;
  year: string;
}

interface Skill {
  category: string;
  items: string[];
}

interface Props {
  education?: Education[];
  skills?: Skill[];
  publications?: string[];
  contact?: {
    email?: string;
    phone?: string;
    location?: string;
  };
}

const {
  education = [],
  skills = [],
  publications = [],
  contact = {},
} = Astro.props;
---

<section class="cv" id="cv">
  <div class="container">
    <h2>Academic CV</h2>

    <div class="cv-grid">
      <div class="cv-column">
        {contact.email || contact.phone || contact.location ? (
          <div class="cv-section">
            <h3>Contact</h3>
            {contact.email && <p>{contact.email}</p>}
            {contact.phone && <p>{contact.phone}</p>}
            {contact.location && <p>{contact.location}</p>}
          </div>
        ) : null}

        {education.length > 0 && (
          <div class="cv-section">
            <h3>Education</h3>
            {education.map((edu) => (
              <div class="cv-item">
                <h4>{edu.degree}</h4>
                <p class="subtext">{edu.field}</p>
                <p class="subtext">{edu.school}</p>
                <p class="year">{edu.year}</p>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="cv-column">
        {skills.length > 0 && (
          <div class="cv-section">
            <h3>Skills</h3>
            {skills.map((skillGroup) => (
              <div class="skill-group">
                <h4>{skillGroup.category}</h4>
                <p>{skillGroup.items.join(' • ')}</p>
              </div>
            ))}
          </div>
        )}

        {publications.length > 0 && (
          <div class="cv-section">
            <h3>Publications</h3>
            <ul class="publications-list">
              {publications.map((pub) => (
                <li>{pub}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cv {
    background-color: var(--color-bg);
    padding: calc(var(--spacing-unit) * 6) 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 3rem;
    text-align: center;
  }

  .cv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .cv-section {
    margin-bottom: 2.5rem;
  }

  .cv-section h3 {
    font-size: 1.3rem;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-border);
  }

  .cv-item {
    margin-bottom: 1.5rem;
  }

  .cv-item h4 {
    margin: 0 0 0.25rem 0;
    color: var(--color-text);
  }

  .subtext {
    font-size: 0.95rem;
    color: var(--color-secondary);
    margin: 0.25rem 0;
  }

  .year {
    font-size: 0.9rem;
    color: var(--color-accent);
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .skill-group {
    margin-bottom: 1.5rem;
  }

  .skill-group h4 {
    margin: 0 0 0.5rem 0;
    color: var(--color-text);
  }

  .skill-group p {
    margin: 0;
    color: var(--color-secondary);
    font-size: 0.95rem;
  }

  .publications-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .publications-list li {
    padding: 0.75rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--color-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .publications-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 2rem;
    }

    .cv-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
