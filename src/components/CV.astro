---
// Simple CV section with links
interface Education {
  degree: string;
  field: string;
  school: string;
  year: string;
}

interface Skill {
  category: string;
  items: string[];
}

interface Props {
  education?: Education[];
  skills?: Skill[];
  publications?: string[];
  cvLink?: string;
  githubLink?: string;
  linkedinLink?: string;
}

const {
  education = [],
  skills = [],
  publications = [],
  cvLink,
  githubLink,
  linkedinLink,
} = Astro.props;
---

<section class="cv" id="about">
  <h2>About Me</h2>
  <div class="about-layout"><aside><img src="/media/taras-portrait.jpg" alt="Taras Fliorko" width="235" height="300" /><h3>Contact Information</h3><a href="mailto:tfliorko@gmail.com">tfliorko@gmail.com</a></aside><div>
  <p>I am a final-year Robotics and Automated Systems student at South East Technological University in Carlow, Ireland. I work across mathematical modelling, mechanical design and embedded control, and am preparing for Master’s study in robotics and control.</p>
  <h3>Research Interests</h3><ul><li>Underactuated robotics and nonlinear dynamics</li><li>Autonomous drones and navigation</li><li>Control theory</li><li>Mathematical modelling and numerical simulation</li><li>Physics and mechanics of robotic systems</li></ul>

  <h3>Links</h3>
  <ul class="links-list">
    {cvLink && <li><a href={cvLink}>CV</a></li>}
    {githubLink && <li><a href={githubLink} target="_blank">GitHub</a></li>}
    {linkedinLink && <li><a href={linkedinLink} target="_blank">LinkedIn</a></li>}
  </ul>

  {education.length > 0 && (
    <>
      <h3>Background</h3>
      <div class="edu-list">
        {education.map((edu) => (
          <div class="edu-item">
            <p>
              <strong>{edu.degree}</strong> in {edu.field}
            </p>
            <p>{edu.school}, {edu.year}</p>
          </div>
        ))}
      </div>
    </>
  )}

  {skills.length > 0 && (
    <>
      <h3>Skills</h3>
      <div class="skills-list">
        {skills.map((skill) => (
          <div class="skill-item">
            <p>
              <strong>{skill.category}:</strong> {skill.items.join(", ")}
            </p>
          </div>
        ))}
      </div>
    </>
  )}

  {publications.length > 0 && (
    <>
      <h3>Publications</h3>
      <ul class="pub-list">
        {publications.map((pub) => (
          <li>{pub}</li>
        ))}
      </ul>
    </>
  )}
<h3>Hobbies</h3><p>Playing piano, bouldering and skiing.</p></div></div></section>

<style>
  .cv {
    margin-bottom: 2rem;
  }

  h2 {
    border-top: 1px solid #000;
    padding-top: 1rem;
    margin-top: 2rem;
  }

  h3 {
    margin-top: 1.5rem;
  }

  .links-list {
    list-style: none;
    padding-left: 0;
    margin-left: 0;
    margin-bottom: 1.5rem;
  }

  .links-list li {
    margin-bottom: 0.5rem;
  }

  .links-list a {
    color: #000;
    text-decoration: underline;
  }

  .edu-list,
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu-item,
  .skill-item {
    margin-bottom: 0.5rem;
  }

  .edu-item p,
  .skill-item p {
    margin: 0.25rem 0;
  }

  .pub-list {
    margin-left: 2rem;
    margin-bottom: 1rem;
  }

  .pub-list li {
    margin-bottom: 0.3rem;
  }
</style>

<style>.about-layout{display:grid;grid-template-columns:235px 1fr;gap:2rem}.about-layout aside img{width:100%;height:auto}.about-layout aside a{overflow-wrap:anywhere}@media(max-width:650px){.about-layout{grid-template-columns:1fr}.about-layout aside img{max-width:235px}}</style>
