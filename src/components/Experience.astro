---
// Experience section component
interface Experience {
  title: string;
  organization: string;
  period: string;
  description: string;
  highlights?: string[];
}

interface Props {
  experiences: Experience[];
}

const { experiences = [] } = Astro.props;
---

<section class="experience" id="experience">
  <div class="container">
    <h2>Experience & Activities</h2>
    <p class="section-intro">
      Industry placements, hackathons, engineering teams, and leadership experience.
    </p>

    {experiences.length > 0 ? (
      <div class="timeline">
        {experiences.map((exp, index) => (
          <div class="timeline-item" class:list={{ first: index === 0 }}>
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <h3>{exp.title}</h3>
              <p class="organization">{exp.organization}</p>
              <p class="period">{exp.period}</p>
              <p class="description">{exp.description}</p>

              {exp.highlights && exp.highlights.length > 0 && (
                <ul class="highlights">
                  {exp.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Experience coming soon...</p>
      </div>
    )}
  </div>
</section>

<style>
  .experience {
    background-color: #f8f9fa;
    padding: calc(var(--spacing-unit) * 6) 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  .section-intro {
    text-align: center;
    color: var(--color-secondary);
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .timeline {
    position: relative;
    padding: 2rem 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-border);
  }

  .timeline-item {
    margin-bottom: 2rem;
    margin-left: 70px;
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    left: -53px;
    top: 8px;
    width: 16px;
    height: 16px;
    background-color: var(--color-accent);
    border: 3px solid var(--color-bg);
    border-radius: 50%;
    transition: all 0.3s;
  }

  .timeline-item:hover .timeline-marker {
    width: 24px;
    height: 24px;
    left: -57px;
    top: 4px;
    box-shadow: 0 0 0 8px rgba(0, 102, 204, 0.1);
  }

  .timeline-content {
    background-color: var(--color-bg);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    transition: all 0.3s;
  }

  .timeline-item:hover .timeline-content {
    box-shadow: 0 4px 12px rgba(0, 102, 204, 0.1);
  }

  .timeline-content h3 {
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .organization {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .period {
    font-size: 0.9rem;
    color: var(--color-secondary);
    margin-bottom: 0.75rem;
  }

  .description {
    color: var(--color-secondary);
    margin-bottom: 1rem;
    line-height: 1.8;
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .highlights li {
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-secondary);
    position: relative;
  }

  .highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 600;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--color-secondary);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 2rem;
    }

    .timeline::before {
      left: 10px;
    }

    .timeline-item {
      margin-left: 50px;
    }

    .timeline-marker {
      left: -27px;
    }

    .timeline-item:hover .timeline-marker {
      left: -31px;
    }
  }
</style>
