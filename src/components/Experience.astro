---
// Experience & Activities section
interface Experience {
  title: string;
  organization: string;
  period: string;
  description?: string;
}

interface Props {
  experiences: Experience[];
}

const { experiences = [] } = Astro.props;
---

<section class="experience" id="experience">
  <h2>Experience & Activities</h2>

  {experiences.length > 0 ? (
    <div class="exp-list">
      {experiences.map((exp) => (
        <div class="exp-item">
          <h3>{exp.title}</h3>
          <p>
            <strong>{exp.organization}</strong><span class="period">{exp.period}</span>
          </p>
          {exp.description && <p>{exp.description}</p>}
        </div>
      ))}
    </div>
  ) : (
    <p><em>Experience coming soon.</em></p>
  )}
</section>

<style>
  .period { margin-left: 1.25rem; }
  .experience {
    margin-bottom: 2rem;
  }

  h2 {
    border-top: 1px solid #000;
    padding-top: 1rem;
    margin-top: 2rem;
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .exp-item {
    margin-bottom: 1rem;
  }

  .exp-item h3 {
    margin: 0 0 0.3rem 0;
  }

  .exp-item p {
    margin: 0.25rem 0;
  }
</style>
