---
// ProjectCard component for displaying individual projects
interface Props {
  title: string;
  description: string;
  tags?: string[];
  link?: string;
  github?: string;
}

const { title, description, tags = [], link, github } = Astro.props;
---

<div class="project-card">
  <h3>{title}</h3>
  <p class="description">{description}</p>

  {tags.length > 0 && (
    <div class="tags">
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}

  <div class="project-links">
    {
      link && (
        <a href={link} target="_blank" rel="noopener noreferrer" class="project-link">
          View Project →
        </a>
      )
    }
    {
      github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="project-link">
          GitHub →
        </a>
      )
    }
  </div>
</div>

<style>
  .project-card {
    background-color: #f8f9fa;
    border-radius: 8px;
    padding: 2rem;
    border: 1px solid var(--color-border);
    transition: all 0.3s;
  }

  .project-card:hover {
    box-shadow: 0 8px 24px rgba(0, 102, 204, 0.1);
    transform: translateY(-4px);
  }

  h3 {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .description {
    color: var(--color-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    display: inline-block;
    background-color: var(--color-accent);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .project-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-link {
    color: var(--color-accent);
    font-weight: 600;
    transition: all 0.2s;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
  }

  .project-link:hover {
    border-bottom-color: var(--color-accent);
  }
</style>
