---
// Simple about section
interface Props {
  university: string;
  academicFocus: string;
  researchStatement: string;
  cvLink?: string;
  githubLink?: string;
  linkedinLink?: string;
}

const {
  university,
  academicFocus,
  researchStatement,
  cvLink,
  githubLink,
  linkedinLink,
} = Astro.props;
---

<section class="about" id="about">
  <h2>About</h2>
  
  <p><strong>University:</strong> {university}</p>
  <p><strong>Research Focus:</strong> {academicFocus}</p>
  
  <h3>Research Statement</h3>
  <p>{researchStatement}</p>

  <h3>Links</h3>
  <ul>
    {cvLink && <li><a href={cvLink}>CV</a></li>}
    {githubLink && <li><a href={githubLink} target="_blank">GitHub</a></li>}
    {linkedinLink && <li><a href={linkedinLink} target="_blank">LinkedIn</a></li>}
  </ul>
</section>

<style>
  .about {
    margin-bottom: 2rem;
  }

  h2 {
    border-top: 1px solid #000;
    padding-top: 1rem;
    margin-top: 2rem;
  }

  h3 {
    margin-top: 1.5rem;
  }

  ul {
    list-style: none;
    padding-left: 0;
    margin-left: 0;
  }

  li {
    margin-bottom: 0.25rem;
  }

  a {
    color: #000;
    text-decoration: underline;
  }
</style>
