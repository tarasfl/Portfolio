---
// Technical Notes section component
interface Note {
  title: string;
  excerpt: string;
  date?: string;
  readTime?: string;
  link?: string;
}

interface Props {
  notes: Note[];
}

const { notes = [] } = Astro.props;
---

<section class="technical-notes" id="notes">
  <div class="container">
    <h2>Technical Notes</h2>
    <p class="section-intro">
      Short articles about interesting problems, derivations, design decisions, and lessons learned.
    </p>

    {notes.length > 0 ? (
      <div class="notes-list">
        {notes.map((note) => (
          <article class="note-item">
            <h3>{note.title}</h3>
            <div class="note-meta">
              {note.date && <span class="date">{note.date}</span>}
              {note.readTime && <span class="read-time">{note.readTime}</span>}
            </div>
            <p class="excerpt">{note.excerpt}</p>
            {note.link && (
              <a href={note.link} class="read-more">
                Read More →
              </a>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Technical articles coming soon...</p>
      </div>
    )}
  </div>
</section>

<style>
  .technical-notes {
    background-color: var(--color-bg);
    padding: calc(var(--spacing-unit) * 6) 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  .section-intro {
    text-align: center;
    color: var(--color-secondary);
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .note-item {
    padding: 2rem;
    border-left: 4px solid var(--color-accent);
    background-color: #f8f9fa;
    border-radius: 4px;
    transition: all 0.3s;
  }

  .note-item:hover {
    box-shadow: 0 4px 12px rgba(0, 102, 204, 0.1);
  }

  .note-item h3 {
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .note-meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: var(--color-secondary);
  }

  .date,
  .read-time {
    display: flex;
    align-items: center;
  }

  .excerpt {
    color: var(--color-secondary);
    margin-bottom: 1rem;
    line-height: 1.8;
  }

  .read-more {
    display: inline-block;
    color: var(--color-accent);
    font-weight: 600;
    transition: all 0.2s;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
  }

  .read-more:hover {
    border-bottom-color: var(--color-accent);
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--color-secondary);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 2rem;
    }

    .note-item {
      padding: 1.5rem;
    }
  }
</style>
