---
// Simple technical notes section
interface Note {
  title: string;
  excerpt: string;
  date?: string;
  link?: string;
}

interface Props {
  notes: Note[];
}

const { notes = [] } = Astro.props;
---

<section class="notes" id="notes">
  <h2>Technical Notes</h2>

  {notes.length > 0 ? (
    <div class="notes-list">
      {notes.map((note) => (
        <div class="note-item">
          <h3>{note.title}</h3>
          {note.date && <p class="date">{note.date}</p>}
          <p>{note.excerpt}</p>
          {note.link && <a href={note.link}>Read more</a>}
        </div>
      ))}
    </div>
  ) : (
    <p><em>Articles coming soon.</em></p>
  )}
</section>

<style>
  .notes {
    margin-bottom: 2rem;
  }

  h2 {
    border-top: 1px solid #000;
    padding-top: 1rem;
    margin-top: 2rem;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .note-item {
    margin-bottom: 1.5rem;
  }

  .note-item h3 {
    margin: 0 0 0.3rem 0;
  }

  .date {
    font-style: italic;
    color: #666;
    margin: 0 0 0.5rem 0;
    font-size: 0.9rem;
  }

  .note-item p {
    margin-bottom: 0.75rem;
  }

  a {
    color: #000;
    text-decoration: underline;
  }
</style>
