---
// Projects section with links to project pages
interface Project {
  id: string;
  title: string;
  description: string;
  link?: string;
  github?: string;
  image?: string;
}

interface Props {
  projects: Project[];
}

const { projects = [] } = Astro.props;
---

<section class="projects" id="projects">
  <h2>Projects &amp; Research</h2>

  {projects.length > 0 ? (
    <div class="projects-list">
      {projects.map((project) => (
        <div class="project-item">
          <h3>
            <a href={`/projects/${project.id}`}>{project.title}</a>
          </h3>
          {project.image && (
            <a href={`/projects/${project.id}`} aria-label={`View ${project.title} photos`}>
              <img src={project.image} alt={project.image.endsWith("-placeholder.svg") ? `${project.title} photo placeholder` : project.title} class="project-photo" width="1200" height="800" loading="lazy" />
            </a>
          )}
          <p>{project.description}</p>
          <div class="project-links">
            <a href={`/projects/${project.id}`}>View Project</a>
            {project.github && (
              <a href={project.github} target="_blank">
                GitHub
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <p><em>Projects coming soon.</em></p>
  )}
</section>

<style>
  .projects {
    margin-bottom: 2rem;
  }

  h2 {
    border-top: 1px solid #000;
    padding-top: 1rem;
    margin-top: 2rem;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-item {
    margin-bottom: 1.5rem;
  }

  .project-item h3 {
    margin: 0 0 0.5rem 0;
  }

  .project-item h3 a {
    color: #000;
    text-decoration: underline;
  }

  .project-item p {
    margin-bottom: 0.75rem;
  }

  .project-photo {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    border: 1px solid #000;
    margin: 1rem 0;
  }

  .project-links {
    display: flex;
    gap: 1.5rem;
  }

  .project-links a {
    color: #000;
    text-decoration: underline;
  }
</style>
