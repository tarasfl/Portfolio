---
// Simple hero/title section
interface Props {
  name: string;
  title: string;
}

const { name, title } = Astro.props;
---

<section class="hero" id="home">
  <h1>{name}</h1>
  <p class="tagline">{title}</p>
</section>

<style>
  .hero {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: normal;
    margin: 0 0 0.5rem 0;
  }

  .tagline {
    font-size: 1.1rem;
    font-style: italic;
    margin: 0;
  }
</style>
