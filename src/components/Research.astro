---
// Experience & Activity section with description and photo
interface Props {
  title: string;
  description: string;
  photo?: string;
}

const { title, description, photo } = Astro.props;
---

<section class="activity" id="activity">
  <h2>{title}</h2>
  
  <div class="activity-content">
    {photo && <img src={photo} alt={title} class="activity-photo" />}
    <div class="activity-text">
      <p>{description}</p>
    </div>
  </div>
</section>

<style>
  .activity {
    margin-bottom: 2rem;
  }

  h2 {
    border-top: 1px solid #000;
    padding-top: 1rem;
    margin-top: 2rem;
  }

  .activity-content {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .activity-photo {
    width: 300px;
    height: 300px;
    object-fit: cover;
    border: 1px solid #000;
    flex-shrink: 0;
  }

  .activity-text p {
    text-align: justify;
  }

  @media (max-width: 768px) {
    .activity-content {
      flex-direction: column;
    }

    .activity-photo {
      width: 100%;
      height: auto;
    }
  }
</style>
